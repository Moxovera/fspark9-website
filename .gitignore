# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# raw reference/working material for the locked report (brief, source
# HTML, proposal doc) — not needed at runtime, the extracted content lives
# in src/content/locked/fuzul/
/fuzul/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sanity typegen (derived — regenerate with `npm run typegen`)
/schema.json

# claude code (local, machine-specific permissions)
.claude/settings.local.json
